{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "swagger": "tsx swagger.ts",
    "build": "npx tsx swagger.ts && tsc",
    "start": "node --env-file=.env dist/app.js",
    "start:worker": "node dist/src/jobs/worker.job.js",
    "start:scheduler": "node dist/src/jobs/scheduler.job.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "dev": "npm run swagger && tsx --watch --env-file=.env src/app.ts",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:fresh": "docker compose down -v && docker compose up -d && npx prisma migrate reset --force",
    "notifications:deadlines": "tsx --env-file=.env src/jobs/notification-deadlines.job.ts",
    "notifications:worker": "tsx --env-file=.env src/jobs/notification-worker.job.ts",
    "migrate:reset": "prisma migrate reset",
    "studio": "prisma studio",
    "filegen": "tsx filegen.ts",
    "seed:project": "tsx --env-file=.env prisma/seed-unassigned-projects.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capmoo-capstone/backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/capmoo-capstone/backend/issues"
  },
  "homepage": "https://github.com/capmoo-capstone/backend#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.5",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "glob": "^12.0.0"
  }
}
