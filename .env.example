# Server Configuration
PORT=3000
NODE_ENV=local

# Database Credentials (Local Docker: postgresql://postgres:postgres@localhost:5433/nexus_local?schema=public)
DATABASE_URL=

# JWT Secret
JWT_SECRET=

# Cron Authentication
CRON_SECRET=

# CU Portal SAML SSO (leave unset to keep SSO endpoints unavailable)
SAML_SP_ENTITY_ID=nexusproc
SAML_SP_ACS_URL=https://api.nexus-procure.com/api/v1/auth/saml/acs
SAML_IDP_METADATA_URL=https://portal.it.chula.ac.th/c/portal/saml/metadata
SAML_IDP_ENTITY_ID=liferay-idp
SAML_FRONTEND_SUCCESS_URL=https://www.nexus-procure.com/app/me/tasks
SAML_FRONTEND_FAILURE_URL=https://www.nexus-procure.com/login

# R2 Storage Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Redis Configuration
REDIS_URL=

# Email Configuration
RESEND_API_KEY=
RESEND_FROM=
VENDOR_APP_PUBLIC_URL=
