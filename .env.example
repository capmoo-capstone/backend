# Server Configuration
PORT=3000
NODE_ENV=local
APP_PUBLIC_URL=https://www.nexus-procure.com
VENDOR_APP_PUBLIC_URL=https://vendor.nexus-procure.com

# Database Credentials (Local Docker: postgresql://postgres:postgres@localhost:5433/nexus_local?schema=public)
DATABASE_URL=

# JWT Secret
JWT_SECRET=

# Cron Authentication
CRON_SECRET=

# Cron execution: queue on the VPS; direct only for the Redis-free Vercel development deployment
CRON_EXECUTION_MODE=direct
# Comma-separated development recipients. Keep empty to suppress direct-mode email delivery.
CRON_EMAIL_ALLOWLIST=

# CU Portal SAML SSO
SAML_SP_ENTITY_ID=nexusproc
SAML_SP_ACS_URL=https://api.nexus-procure.com/api/v1/auth/saml/acs
SAML_IDP_METADATA_URL=https://portal.it.chula.ac.th/c/portal/saml/metadata
SAML_IDP_ENTITY_ID=liferay-idp
SAML_FRONTEND_REDIRECT_URL=https://www.nexus-procure.com/login

# R2 Storage Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Redis Configuration
REDIS_URL=
REDIS_TLS_CA_PATH=/app/certs/redis-ca.crt
REDIS_TLS_REJECT_UNAUTHORIZED=true
NOTIFICATIONS_REALTIME_ENABLED=true
REDIS_TLS_SERVERNAME=nexusproc

# Email Configuration
RESEND_API_KEY=
RESEND_FROM=
