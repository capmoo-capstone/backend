// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum UserRole {
  SUPER_ADMIN
  ADMIN
  HEAD_OF_DEPARTMENT
  HEAD_OF_UNIT
  REPRESENTATIVE
  DOCUMENT_STAFF
  FINANCE_STAFF
  GENERAL_STAFF
  GUEST
}

enum RegisterType {
  SSO
  STANDARD
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  UNASSIGNED
  WAITING_ACCEPT
  IN_PROGRESS
  WAITING_CANCEL
  WAITING_CLOSE
  CANCELLED
  CLOSED
}

enum ProjectInstallmentStatus {
  WAITING_EXPORT
  EXPORTED
  REQUEST_EDIT
}

enum UnitResponsibleType {
  LT100K
  LT500K
  MT500K
  SELECTION
  EBIDDING
  INTERNAL
  CONTRACT
}

enum AuditLogType {
  PROJECT_HISTORY
  PROJECT_CANCELLATION
  USER_DELEGATION
  CONTRACT_NUMBER
  USER_MANAGEMENT
}

enum AuditEventType {
  PROJECT_DATA_UPDATED
  PROJECT_ASSIGNEE_UPDATED
  PROJECT_STATUS_UPDATED
  PROJECT_STEP_UPDATED
  USER_DELEGATION_CREATED
  USER_DELEGATION_CANCELLED
  PROJECT_CANCELLATION_CREATED
  PROJECT_CANCELLATION_APPROVED
  PROJECT_CANCELLATION_REJECTED
  CONTRACT_NUMBER_CREATED
  CONTRACT_NUMBER_CANCELLED
  USER_ROLE_ASSIGNED
  USER_ROLE_REMOVED
  UNIT_STAFF_ADDED
  UNIT_STAFF_REMOVED
  REGISTRATION_REQUESTED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  USER_CREATED
  USER_STATUS_UPDATED
}

enum AuditTargetType {
  PROJECT
  USER_DELEGATION
  PROJECT_CANCELLATION
  CONTRACT_NUMBER
  USER
  REGISTRATION_REQUEST
}

enum ProjectActionType {
  INFORMATION_UPDATE
  STATUS_UPDATE
  ASSIGNEE_UPDATE
  STEP_UPDATE
}

enum ProjectCancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProcurementType {
  LT100K
  LT500K
  MT500K
  SELECTION
  EBIDDING
  INTERNAL
}

enum SubmissionStatus {
  WAITING_APPROVAL
  WAITING_PROPOSAL
  WAITING_SIGNATURE
  COMPLETED
  REJECTED
}

enum ProjectPhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_APPROVAL
  WAITING_PROPOSAL
  WAITING_SIGNATURE
  NOT_EXPORTED
  COMPLETED
  REJECTED
}

enum SubmissionType {
  STAFF
  VENDOR
}

enum UrgentType {
  NORMAL
  URGENT
  VERY_URGENT
  SUPER_URGENT
}

enum NotificationCategory {
  ASSIGNMENTS
  APPROVALS
  DEADLINES
  WORKFLOW_UPDATES
  CANCELLATIONS
  DELEGATION
  VENDOR_SUBMISSIONS
  FINANCE_HANDOFFS
  SYSTEM_ACCOUNT
}

enum NotificationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum NotificationChannel {
  IN_APP
  EMAIL_IMMEDIATE
  EMAIL_DIGEST
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// --- MODELS ---

model Department {
  id   String @id
  name String

  units                 Unit[]
  organization_roles    UserOrganizationRole[]
  registration_requests RegistrationRequest[]
  projects              Project[]

  @@map("departments")
}

model Unit {
  id          String                @id
  dept_id     String
  name        String
  budget_code String?
  type        UnitResponsibleType[]

  organization_roles         UserOrganizationRole[]
  requesting_projects        Project[]              @relation("RequestingUnit")
  responsible_projects       Project[]              @relation("ResponsibleUnit")
  procurement_phase_projects Project[]              @relation("ProcurementPhaseUnit")
  contract_phase_projects    Project[]              @relation("ContractPhaseUnit")

  department  Department   @relation(fields: [dept_id], references: [id], onDelete: Restrict)
  budgetPlans BudgetPlan[]

  @@map("units")
}

model User {
  id              String         @id @default(uuid())
  username        String         @unique
  email           String?        @unique
  password        String?
  register_type   RegisterType[] @default([STANDARD])
  full_name       String
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now())
  role_updated_at DateTime       @default(now())
  last_login_at   DateTime?
  daily_email     Boolean        @default(false)

  roles UserOrganizationRole[]

  delegations_given    UserDelegation[] @relation("Delegator")
  delegations_received UserDelegation[] @relation("Delegatee")

  procurement_projects Project[] @relation("ProcurementProjects")
  contract_projects    Project[] @relation("ContractProjects")
  created_projects     Project[] @relation("ProjectCreator")

  submitted_submissions    ProjectSubmission[]    @relation("SubmitBy")
  approved_submissions     ProjectSubmission[]    @relation("ApprovedBy")
  proposed_submissions     ProjectSubmission[]    @relation("ProposedBy")
  completed_submissions    ProjectSubmission[]    @relation("CompletedBy")
  installment_exports      ProjectInstallment[]   @relation("ProjectInstallmentExporter")
  installment_creations    ProjectInstallment[]   @relation("ProjectInstallmentCreator")
  cancellation_requests    ProjectCancellation[]  @relation("CancelRequester")
  cancellation_decisions   ProjectCancellation[]  @relation("CancelDecider")
  delegation_creations     UserDelegation[]       @relation("DelegationCreator")
  delegation_cancellations UserDelegation[]       @relation("DelegationCanceller")
  notifications            Notification[]
  notification_deliveries  NotificationDelivery[]
  notification_reminders   NotificationReminder[]
  notification_outbox      NotificationOutbox[]

  @@map("users")
}

model RegistrationRequest {
  id              String             @id @default(uuid())
  username        String
  email           String
  full_name       String
  dept_id         String
  unit_id         String[]           @default([])
  register_type   RegisterType[]     @default([SSO])
  status          RegistrationStatus @default(PENDING)
  reviewed_by     String?
  reviewed_at     DateTime?
  created_user_id String?            @unique
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  department Department @relation(fields: [dept_id], references: [id], onDelete: Restrict)

  @@index([status, created_at(sort: Desc)])
  @@index([username])
  @@index([email])
  @@map("registration_requests")
}

model SamlRequestCache {
  key        String   @id
  value      String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([expires_at])
  @@map("saml_request_cache")
}

model SamlResponseReplay {
  response_hash String   @id
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@index([expires_at])
  @@map("saml_response_replays")
}

model UserDelegation {
  id           String    @id @default(uuid())
  delegator_id String
  delegatee_id String
  role         UserRole?
  unit_id      String?
  start_date   DateTime
  end_date     DateTime?
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  created_by   String
  cancelled_at DateTime?
  cancelled_by String?

  delegator User  @relation("Delegator", fields: [delegator_id], references: [id], onDelete: Restrict)
  delegatee User  @relation("Delegatee", fields: [delegatee_id], references: [id], onDelete: Restrict)
  creator   User  @relation("DelegationCreator", fields: [created_by], references: [id], onDelete: Restrict)
  canceller User? @relation("DelegationCanceller", fields: [cancelled_by], references: [id], onDelete: SetNull)

  @@index([delegatee_id, is_active])
  @@index([delegatee_id, is_active, role, unit_id], map: "user_delegations_delegatee_active_scope_idx")
  @@index([delegator_id])
  @@index([delegator_id, is_active, role, unit_id], map: "user_delegations_delegator_active_scope_idx")
  @@map("user_delegations")
}

model UserOrganizationRole {
  id      String   @id @default(uuid())
  user_id String
  role    UserRole
  dept_id String
  unit_id String?

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  department Department @relation(fields: [dept_id], references: [id], onDelete: Restrict)
  unit       Unit?      @relation(fields: [unit_id], references: [id], onDelete: SetNull)

  @@index([dept_id])
  @@index([unit_id])
  @@index([user_id])
  @@map("user_organization_roles")
}

model Project {
  id                       String              @id @default(uuid())
  receive_no               String
  title                    String
  description              String?
  budget                   Decimal?            @db.Decimal(18, 2)
  actual_cost              Decimal?            @db.Decimal(18, 2)
  status                   ProjectStatus
  procurement_type         ProcurementType
  current_workflow_type    UnitResponsibleType
  responsible_unit_id      String
  procurement_unit_id      String?
  contract_unit_id         String?
  requesting_dept_id       String
  requesting_unit_id       String?
  is_urgent                UrgentType          @default(NORMAL)
  expected_approval_date   DateTime?
  installment_rounds       Int                 @default(1)
  procurement_started_at   DateTime?
  procurement_completed_at DateTime?
  contract_started_at      DateTime?
  contract_completed_at    DateTime?
  procurement_progress     Json                @default("{\"GENERAL_STAFF\":{\"status\":\"NOT_STARTED\",\"step\":null},\"HEAD_OF_UNIT\":{\"status\":\"NOT_STARTED\",\"step\":null},\"DOCUMENT_STAFF\":{\"status\":\"NOT_STARTED\",\"step\":null}}")
  contract_progress        Json                @default("{\"GENERAL_STAFF\":{\"status\":\"NOT_STARTED\",\"step\":null},\"HEAD_OF_UNIT\":{\"status\":\"NOT_STARTED\",\"step\":null},\"DOCUMENT_STAFF\":{\"status\":\"NOT_STARTED\",\"step\":null}}")
  pr_no                    String?
  po_no                    String?
  less_no                  String?
  migo_103_no              String?
  migo_105_no              String?
  contract_no_id           String?             @unique
  asset_code               Boolean?
  vendor_name              String?
  vendor_email             String?
  created_by               String
  created_at               DateTime            @default(now())
  updated_at               DateTime?           @updatedAt

  creator          User                   @relation("ProjectCreator", fields: [created_by], references: [id], onDelete: Restrict)
  requesting_dept  Department             @relation(fields: [requesting_dept_id], references: [id], onDelete: Restrict)
  requesting_unit  Unit?                  @relation("RequestingUnit", fields: [requesting_unit_id], references: [id], onDelete: SetNull)
  responsible_unit Unit?                  @relation("ResponsibleUnit", fields: [responsible_unit_id], references: [id], onDelete: Restrict)
  procurement_unit Unit?                  @relation("ProcurementPhaseUnit", fields: [procurement_unit_id], references: [id], onDelete: Restrict)
  contract_unit    Unit?                  @relation("ContractPhaseUnit", fields: [contract_unit_id], references: [id], onDelete: Restrict)
  contract_no      ProjectContractNumber? @relation(fields: [contract_no_id], references: [id], onDelete: SetNull)

  assignee_procurement   User[]                 @relation("ProcurementProjects")
  assignee_contract      User[]                 @relation("ContractProjects")
  project_cancellation   ProjectCancellation[]
  project_histories      ProjectHistory[]
  project_installments   ProjectInstallment[]
  submissions            ProjectSubmission[]
  budget_plans           BudgetPlan[]
  notifications          Notification[]
  notification_reminders NotificationReminder[]

  @@index([receive_no(sort: Desc)])
  @@index([status, current_workflow_type])
  @@index([requesting_dept_id])
  @@index([responsible_unit_id])
  @@index([procurement_unit_id, created_at])
  @@index([contract_unit_id, created_at])
  @@index([created_at])
  @@index([procurement_completed_at])
  @@index([contract_completed_at])
  @@map("projects")
}

model ProjectInstallment {
  id                  String                   @id @default(uuid())
  project_id          String
  installment_no      Int
  status              ProjectInstallmentStatus @default(WAITING_EXPORT)
  request_edit_reason String?
  created_by          String
  created_at          DateTime                 @default(now())
  exported_by         String?
  exported_at         DateTime?

  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  exporter User?   @relation("ProjectInstallmentExporter", fields: [exported_by], references: [id], onDelete: SetNull)
  creator  User    @relation("ProjectInstallmentCreator", fields: [created_by], references: [id], onDelete: Restrict)

  @@unique([project_id, installment_no])
  @@index([status])
  @@map("project_installments")
}

model Notification {
  id              String               @id @default(uuid())
  user_id         String
  project_id      String?
  actor_id        String?
  category        NotificationCategory
  priority        NotificationPriority
  title           String
  body            String
  target_path     String?
  action_label    String?
  requires_action Boolean              @default(false)
  is_read         Boolean              @default(false)
  read_at         DateTime?
  dedupe_key      String?
  metadata        Json?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  user                  User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project               Project?               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  deliveries            NotificationDelivery[]
  outbox                NotificationOutbox[]
  notificationReminders NotificationReminder[]

  @@unique([user_id, dedupe_key], map: "notifications_user_id_dedupe_key_key")
  @@index([user_id, is_read, created_at(sort: Desc)])
  @@index([user_id, category, created_at(sort: Desc)])
  @@index([project_id, created_at(sort: Desc)])
  @@map("notifications")
}

model NotificationDelivery {
  id              String                     @id @default(uuid())
  notification_id String?
  user_id         String
  channel         NotificationChannel
  status          NotificationDeliveryStatus @default(PENDING)
  subject         String
  body            String?
  dedupe_key      String?
  error_message   String?
  sent_at         DateTime?
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @updatedAt

  notification Notification? @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, channel, dedupe_key], map: "notification_deliveries_user_id_channel_dedupe_key_key")
  @@index([user_id, channel, status, created_at(sort: Desc)])
  @@index([notification_id])
  @@map("notification_deliveries")
}

model NotificationReminder {
  id              String    @id @default(uuid())
  user_id         String
  project_id      String
  notification_id String?
  target_key      String
  window_key      String
  scheduled_for   DateTime
  sent_at         DateTime?
  error_message   String?
  metadata        Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notification_id], references: [id], onDelete: SetNull)

  @@unique([user_id, project_id, target_key, window_key, scheduled_for])
  @@index([user_id, sent_at, scheduled_for(sort: Desc)])
  @@index([project_id, target_key, scheduled_for(sort: Desc)])
  @@map("notification_reminders")
}

model NotificationOutbox {
  id                String                   @id @default(uuid())
  notification_id   String
  user_id           String
  event_type        String
  payload           Json
  unread_count      Int
  status            NotificationOutboxStatus @default(PENDING)
  attempts          Int                      @default(0)
  last_attempted_at DateTime?
  published_at      DateTime?
  error_message     String?
  created_at        DateTime                 @default(now())
  updated_at        DateTime                 @updatedAt

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([notification_id])
  @@index([status, created_at(sort: Asc)])
  @@index([user_id, status, created_at(sort: Asc)])
  @@map("notification_outbox")
}

model ProjectContractNumber {
  id                  String    @id @default(uuid())
  type                String
  contract_no         String
  is_active           Boolean   @default(true)
  cancellation_reason String?
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt
  project             Project?

  @@unique([type, contract_no])
  @@index([is_active])
  @@map("project_contract_numbers")
}

model ProjectCancellation {
  id           String                    @id @default(uuid())
  project_id   String
  reason       String
  status       ProjectCancellationStatus @default(PENDING)
  requested_by String
  requested_at DateTime                  @default(now())
  decision_by  String?
  decision_at  DateTime?

  project   Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requester User    @relation("CancelRequester", fields: [requested_by], references: [id], onDelete: Restrict)
  decider   User?   @relation("CancelDecider", fields: [decision_by], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@map("project_cancellations")
}

model ProjectHistory {
  id         String            @id @default(uuid())
  project_id String
  action     ProjectActionType
  old_value  Json
  new_value  Json
  comment    String?
  changed_by String
  changed_at DateTime          @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([project_id, action, changed_at(sort: Desc)])
  @@map("project_histories")
}

model AuditEvent {
  id              String          @id @default(uuid())
  kind            AuditLogType
  event_type      AuditEventType
  target_type     AuditTargetType
  target_id       String
  project_id      String?
  actor_id        String?
  actor_snapshot  Json
  target_snapshot Json
  diff            Json?
  comment         String?
  metadata        Json?
  search_text     String?
  source_table    String?
  source_id       String?
  occurred_at     DateTime        @default(now())
  created_at      DateTime        @default(now())

  @@unique([source_table, source_id, event_type])
  @@index([occurred_at(sort: Desc)])
  @@index([kind, occurred_at(sort: Desc)])
  @@index([event_type, occurred_at(sort: Desc)])
  @@index([project_id, occurred_at(sort: Desc)])
  @@index([actor_id, occurred_at(sort: Desc)])
  @@map("audit_events")
}

model ProjectSubmission {
  id               String              @id @default(uuid())
  project_id       String
  workflow_type    UnitResponsibleType
  step_order       Int
  submission_type  SubmissionType      @default(STAFF)
  submission_round Int
  installment_no   Int?
  po_no            String?
  status           SubmissionStatus
  submitted_by     String?
  submitted_at     DateTime            @default(now())
  approved_by      String?
  approved_at      DateTime?
  proposing_by     String?
  proposing_at     DateTime?
  completed_by     String?
  completed_at     DateTime?
  signed_at        DateTime?
  comment          String?
  staff_remark     String?
  meta_data        Json[]

  project   Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  submitter User?             @relation("SubmitBy", fields: [submitted_by], references: [id], onDelete: SetNull)
  approver  User?             @relation("ApprovedBy", fields: [approved_by], references: [id], onDelete: SetNull)
  proposer  User?             @relation("ProposedBy", fields: [proposing_by], references: [id], onDelete: SetNull)
  completer User?             @relation("CompletedBy", fields: [completed_by], references: [id], onDelete: SetNull)
  documents ProjectDocument[]

  @@index([project_id, submitted_at(sort: Desc)])
  @@index([project_id, step_order, submission_type])
  @@index([project_id, workflow_type, installment_no, step_order, submission_type])
  @@map("project_submissions")
}

model ProjectDocument {
  id            String  @id @default(uuid())
  submission_id String
  field_key     String?
  file_name     String
  file_path     String

  submission ProjectSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@map("project_documents")
}

model BudgetPlan {
  id                 String   @id @default(uuid())
  budget_year        Int
  unit_id            String
  activity_type      Int
  activity_type_name String
  description        String?
  budget_name        String?
  budget_amount      Decimal  @db.Decimal(18, 2)
  project_id         String?
  created_at         DateTime @default(now())
  created_by         String

  unit    Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([unit_id])
  @@index([project_id])
  @@map("budget_plans")
}

model Holiday {
  id   String   @id @default(uuid())
  date DateTime @db.Date
  name String

  @@unique([date])
  @@index([date])
  @@map("holidays")
}
